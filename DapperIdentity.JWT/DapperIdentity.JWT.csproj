<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The namespaces carry the CPE. prefix (D-051) while the project file does not, so
         RootNamespace has to be stated - otherwise it defaults to the project name and every new
         file lands in the old namespace. -->
    <RootNamespace>CPE.DapperIdentity.JWT</RootNamespace>
  </PropertyGroup>

</Project>
